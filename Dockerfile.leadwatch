FROM golang:1.26.5-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/leadwatch ./cmd/leadwatch
COPY leadwatch ./leadwatch
COPY threads ./threads
COPY pkg ./pkg
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/leadwatch ./cmd/leadwatch

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/leadwatch /leadwatch
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/leadwatch"]
